{
  // Editor: Solo una pestaña visible y cierre automático de editores inactivos
  "workbench.editor.showTabs": "single",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 3,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.revealIfOpen": true,
  
  // Tema y colores personalizados
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#faaf51",
    "activityBar.background": "#faaf51",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#047c47",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#faaf51",
    "statusBar.background": "#f89820",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#de7e07",
    "statusBarItem.remoteBackground": "#f89820",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#f89820",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#f8982099",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "peacock.color": "#f89820"
}
